diff --git a/campaign/verify-phase-1.ts b/campaign/verify-phase-1.ts
new file mode 100644
index 0000000..98afcb8
--- /dev/null
+++ b/campaign/verify-phase-1.ts
@@ -0,0 +1,332 @@
+/**
+ * PHASE 1 protocol/setup validator. Plays no game and runs no search: it parses the frozen setup
+ * file and the proposed specs through the real engine code, checks legality and job mapping, and
+ * proves whether the residual evaluator is a real blob that the executable path actually uses.
+ *
+ *   node_modules/.bin/tsx campaign/verify-phase-1.ts
+ *
+ * Exit code 0 = every check passed. Exit code 1 = at least one failed check (details on stdout).
+ */
+import { createHash } from 'node:crypto';
+import { readFileSync, readdirSync } from 'node:fs';
+import { fromFen, toFen } from '../src/rules/setup';
+import { DEFAULT_RULES, RULES, setRules } from '../src/rules/rules';
+import { LETTERS, PieceType, Status, colorOf, legalMoves, status, typeOf } from '../src/rules/engine';
+import { RunSpec, buildJobs, loadSpec, sideOptions, usePairs } from '../src/sim/spec';
+import { specKey, sourceId } from '../src/sim/identity';
+import { EvalParams, evaluateBoard, evalBoard, evaluatorName, setEvalParams, setEvaluator } from '../src/ai/eval';
+import { HIDDEN, INPUTS, N_WEIGHTS, QA, QB, RESIDUAL_MAX, W_MAX, netKind, netLoaded, packNet } from '../src/ai/nnue/net';
+import { NET_B64, NET_KIND } from '../src/ai/nnue/weights';
+
+const SETUPS = 'campaign/setups/phase-1.json';
+const SPEC_DIR = 'campaign/specs';
+const NET_JSON = 'sim/nnue/net.json';
+const EVAL_LINEAR = 'sim/nnue/eval-linear.json';
+const EVAL_RESIDUAL = 'sim/nnue/eval-residual.json';
+const PINNED_RESIDUAL = 'campaign/specs/phase-1-residual-eval.json';
+const LEDGER = 'campaign/specs/phase-1-budget-ledger.json';
+
+const NET_LETTERS = 'PNBRQKALGMS';
+const LAB_LETTERS = 'OCVT';
+/** model sha256 recorded for the accepted Q6 residual net (docs/research/ai-q6-acceptance-2026-09-16.md). */
+const Q6_ACCEPTED_SHA = 'e17a27bfbadb029e419082ce8dae4b3c6df7ca6e4d983e02b975772f60c9b58c';
+const notes: string[] = [];
+const results: { name: string; ok: boolean; detail: string }[] = [];
+const check = (name: string, ok: boolean, detail = ''): void => { results.push({ name, ok, detail }); };
+const pass = (name: string, detail = ''): void => check(name, true, detail);
+const fail = (name: string, detail: string): void => check(name, false, detail);
+const sha = (s: string | Buffer): string => createHash('sha256').update(s).digest('hex');
+
+interface Setup {
+  id: string; kind: string;
+  white: { backRank: string; composition: string };
+  black: { backRank: string; composition: string };
+  fen: string; fenSwapped: string;
+  bothHaveArcher: boolean; bothHaveBeast: boolean; hasGuardEitherSide: boolean;
+}
+
+/** The colour-and-rank mirror of a start FEN: flip rank order and swap case, keep White to move. */
+function mirrorFen(fen: string): string {
+  const [board, ...rest] = fen.trim().split(/\s+/);
+  const rows = board.split('/').map(row => row.split('').map(ch => {
+    if (/\d/.test(ch)) return ch;
+    return ch === ch.toUpperCase() ? ch.toLowerCase() : ch.toUpperCase();
+  }).join(''));
+  // rows are written rank 8 -> rank 1; reversing the row order mirrors ranks.
+  return `${rows.reverse().join('/')} ${rest.join(' ')}`;
+}
+
+function censusBoard(fen: string): { fen: string; kings: string; lab: string; pawnRanks: string; legal: number; st: Status; checked: boolean } {
+  const pos = fromFen(fen);
+  let kings = '', lab = '', pawnRanks = '';
+  for (let s = 0; s < 64; s++) {
+    const p = pos.board[s];
+    if (!p) continue;
+    const t = typeOf(p) as number;
+    const letter = LETTERS[t];
+    const rank = s >> 3;
+    if (letter === 'K') kings += colorOf(p) === 0 ? 'W' : 'B';
+    if (LAB_LETTERS.includes(letter)) lab += letter;
+    if (letter === 'P' && (rank === 0 || rank === 7)) pawnRanks += `${letter}@${s}`;
+  }
+  return {
+    fen: toFen(pos), kings: kings.split('').sort().join(''), lab, pawnRanks,
+    legal: legalMoves(pos).length, st: status(pos),
+    checked: (() => { const s = status(pos); return s === 'checkmate' || s === 'stalemate'; })(),
+  };
+}
+
+// ---------------------------------------------------------------------------------------------
+// 1. Setups: legality, mirror rule, coverage.
+
+const setupsDoc = JSON.parse(readFileSync(SETUPS, 'utf8')) as { setups: Setup[]; coverage: Record<string, unknown> };
+const setups = setupsDoc.setups;
+check('setups: count >= 80', setups.length >= 80, `${setups.length} setups`);
+
+let idSet = new Set<string>();
+let illegal = 0, mirrorBad = 0, labSeen = 0, swapNotMirror = 0, mutated = new Set<string>();
+const lettersSeen = new Set<string>();
+for (const s of setups) {
+  if (idSet.has(s.id)) fail('setups: unique ids', `duplicate ${s.id}`);
+  idSet.add(s.id);
+  const c = censusBoard(s.fen);
+  if (c.fen !== s.fen) { fail(`setup ${s.id}: FEN round-trip`, `fromFen->toFen gave ${c.fen}`); mutated.add(s.id); }
+  if (c.kings !== 'BW') { illegal++; fail(`setup ${s.id}: kings`, `kings=${c.kings}`); }
+  if (c.lab) { labSeen++; fail(`setup ${s.id}: lab piece`, c.lab); }
+  if (c.pawnRanks) { illegal++; fail(`setup ${s.id}: pawn on back rank`, c.pawnRanks); }
+  if (c.st !== 'playing') { illegal++; fail(`setup ${s.id}: status`, `${c.st}`); }
+  if (c.legal <= 0) { illegal++; fail(`setup ${s.id}: legal moves`, `0`); }
+  if (mirrorFen(s.fen) !== s.fenSwapped) { swapNotMirror++; fail(`setup ${s.id}: fenSwapped`, `expected ${mirrorFen(s.fen)}`); }
+  const cswap = censusBoard(s.fenSwapped);
+  if (cswap.kings !== 'BW' || cswap.st !== 'playing' || cswap.lab || cswap.legal <= 0) fail(`setup ${s.id}: fenSwapped legal`, `${cswap.st}/${cswap.kings}/${cswap.lab}/${cswap.legal}`);
+  for (const ch of s.white.backRank + s.black.backRank) if (NET_LETTERS.includes(ch)) lettersSeen.add(ch);
+}
+pass('setups: all FENs round-trip and are legal', `mutated=${mutated.size} illegal=${illegal} lab=${labSeen}`);
+pass('setups: fenSwapped is the colour-and-rank mirror', `mismatches=${swapNotMirror}`);
+// Pawns sit on ranks 2/7 by construction and are not part of any back rank, so only the non-king
+// back-rank kinds are required here.
+const needLetters = NET_LETTERS.split('').filter(l => l !== 'K' && l !== 'P');
+const missing = needLetters.filter(l => !lettersSeen.has(l));
+check('setups: every current-game piece kind appears', missing.length === 0, missing.length ? `missing ${missing.join('')}` : `${needLetters.join('')} all seen`);
+check('setups: both kinds present', setups.filter(s => s.kind === 'mirror-start').length >= 40 && setups.filter(s => s.kind === 'asymmetric-start').length >= 16,
+  `${setups.filter(s => s.kind === 'mirror-start').length} mirror, ${setups.filter(s => s.kind === 'asymmetric-start').length} asymmetric`);
+check('setups: archer-bearing subset >= 40', setups.filter(s => s.bothHaveArcher).length >= 40, `${setups.filter(s => s.bothHaveArcher).length}`);
+check('setups: beast-bearing subset >= 40', setups.filter(s => s.bothHaveBeast).length >= 40, `${setups.filter(s => s.bothHaveBeast).length}`);
+const mirrorSetups = setups.filter(s => s.kind === 'mirror-start');
+check('setups: mirror starts are self-mirroring', mirrorSetups.every(s => s.fen === s.fenSwapped), `${mirrorSetups.length}`);
+check('setups: asymmetric starts hand the structure to the other army', setups.filter(s => s.kind === 'asymmetric-start').every(s => s.fen !== s.fenSwapped), '');
+
+// ---------------------------------------------------------------------------------------------
+// 2. Specs: parse with the real loader, map jobs, freeze the arms.
+
+const specFiles = readdirSync(SPEC_DIR).filter(f => /^phase-1-.*\.json$/.test(f)).filter(f => {
+  // The pinned residual arm is an EvalParams file, not a RunSpec; skip anything without id/games.
+  const j = JSON.parse(readFileSync(`${SPEC_DIR}/${f}`, 'utf8')) as { id?: unknown; games?: unknown };
+  return typeof j.id === 'string' && typeof j.games === 'number' && j.games > 0;
+}).sort();
+const setupFens = new Set(setups.flatMap(s => [s.fen, s.fenSwapped]));
+interface Loaded { file: string; spec: RunSpec; key: string }
+const loaded: Loaded[] = [];
+for (const file of specFiles) {
+  const spec = loadSpec(['--spec', `${SPEC_DIR}/${file}`]);
+  loaded.push({ file, spec, key: specKey(spec) });
+  const jobs = buildJobs(spec);
+  check(`${file}: id/games`, !!spec.id && spec.games > 0, `${spec.id} games=${spec.games}`);
+  check(`${file}: buildJobs count == games`, jobs.length === spec.games, `${jobs.length}`);
+  check(`${file}: pairs on`, usePairs(spec) === true, `${usePairs(spec)}`);
+  check(`${file}: no early adjudication`, spec.adjudicate === false, `${JSON.stringify(spec.adjudicate)}`);
+
+  // Every run must carry an explicit finite per-move time guard on both sides. A depth-only spec
+  // would make sideOptions return timeMs = Infinity (no wall-clock safety).
+  const sides = sideOptions(spec);
+  const finite = sides.every(s => Number.isFinite(s.timeMs) && s.timeMs > 0);
+  check(`${file}: finite per-move timeMs on both sides`, finite, sides.map(s => `maxDepth=${s.maxDepth ?? '-'} timeMs=${s.timeMs}`).join(' | '));
+
+  const N = spec.asymmetric?.length ?? 0;
+  const nCfg = new Set(jobs.map(j => j.configId)).size;
+  check(`${file}: one config per listed setup`, nCfg === N, `configs=${nCfg} listed=${N}`);
+  // buildJobs maps pair k to setup (k mod N), so the mapping is modulo, not identity.
+  let pairBad = 0, fenBad = 0, cfgBad = 0, nonSetup = 0;
+  const unitKeys = new Set<string>();
+  // A single-engine spec puts the same settings both sides, so the two orientations of a mirror
+  // start are structurally the same game (same seed, same start); they are one independent unit.
+  const bothSidesSame = JSON.stringify(spec.ai.white ?? null) === JSON.stringify(spec.ai.black ?? null);
+  const singleEngine = (spec.evalParams?.white ?? null) === (spec.evalParams?.black ?? null) && bothSidesSame;
+  for (let i = 0; i < jobs.length; i++) {
+    const j = jobs[i];
+    if (j.pairId !== (i >> 1) || j.colourSwapped !== ((i & 1) === 1)) pairBad++;
+    const entry = spec.asymmetric![j.pairId % N];
+    const want = j.colourSwapped ? entry.fenSwapped : entry.fen;
+    if (j.fen !== want) fenBad++;
+    const wantCfg = entry.white === entry.black ? entry.white : `${entry.white} vs ${entry.black}`;
+    if (j.configId !== wantCfg) cfgBad++;
+    if (j.fen && !setupFens.has(j.fen)) nonSetup++;
+    const stream = spec.commonSeeds ? Math.floor(j.pairId / N) : j.pairId;
+    const orientationIndependent = !(singleEngine && entry.fen === entry.fenSwapped);
+    unitKeys.add(`${j.configId}#${stream}#${orientationIndependent ? (j.colourSwapped ? 'b' : 'a') : 'x'}`);
+  }
+  const dupRecords = jobs.length - unitKeys.size;
+  check(`${file}: modulo pair mapping (setup = pairId mod N)`, pairBad === 0 && fenBad === 0 && cfgBad === 0, `pairBad=${pairBad} fenBad=${fenBad} cfgBad=${cfgBad}`);
+  check(`${file}: every job fen is a frozen setup fen`, nonSetup === 0, `foreign=${nonSetup}`);
+  check(`${file}: honest unit accounting`, unitKeys.size <= jobs.length, `physical=${jobs.length} independentUnits=${unitKeys.size} structuralDuplicates=${dupRecords} (singleEngine=${singleEngine})`);
+  const firstFen = spec.asymmetric?.[0]?.fen;
+  if (firstFen) check(`${file}: all fens are legal`, censusBoard(firstFen).kings === 'BW', 'sampled first entry');
+}
+check('specs: all spec files loaded', loaded.length >= 5, loaded.map(l => l.spec.id).join(', '));
+
+// Frozen rule arms: the archer A/B differs only in archerShots; the evaluator specs pin evalParams.
+const byId = new Map(loaded.map(l => [l.spec.id, l.spec]));
+const a = byId.get('phase-1-archer-adopted'), b = byId.get('phase-1-archer-classic');
+if (a && b) {
+  const ra = { ...DEFAULT_RULES, ...a.rules }, rb = { ...DEFAULT_RULES, ...b.rules };
+  const diffs = Object.keys(ra).filter(k => JSON.stringify((ra as Record<string, unknown>)[k]) !== JSON.stringify((rb as Record<string, unknown>)[k]));
+  check('archer arms: exactly one rule differs', diffs.length === 1 && diffs[0] === 'archerShots', diffs.join(','));
+  check('archer arms: adopted=plusDiagFwd2, classic=classic', a.rules?.archerShots === 'plusDiagFwd2' && b.rules?.archerShots === 'classic', `${a.rules?.archerShots}/${b.rules?.archerShots}`);
+  const sameShared = a.seed === b.seed && a.games === b.games && a.commonSeeds === b.commonSeeds && a.pairs === b.pairs
+    && JSON.stringify(a.asymmetric) === JSON.stringify(b.asymmetric) && JSON.stringify(a.ai) === JSON.stringify(b.ai);
+  check('archer arms: same setups, seed and search', sameShared, `seed ${a.seed}`);
+  // The adopted arm's rules must equal today's defaults apart from nothing: it is the current game.
+  const currentDiffs = Object.keys(ra).filter(k => JSON.stringify((ra as Record<string, unknown>)[k]) !== JSON.stringify((DEFAULT_RULES as unknown as Record<string, unknown>)[k]));
+  check('adopted archer arm == current adopted rules', currentDiffs.length === 0, currentDiffs.join(','));
+  check('classic arm freezes Beast/promotions/values', b.rules?.beastCapture === 'adjacent' && b.rules?.beastCaptureForward === true
+    && b.rules?.beastMove === 'any' && b.rules?.beastChains === true && b.rules?.promotionSet === 'standard' && b.rules?.paladinKamikaze === 'nonPawn',
+    JSON.stringify({ beastCapture: b.rules?.beastCapture, promo: b.rules?.promotionSet }));
+}
+for (const id of ['phase-1-eval-linear-vs-residual', 'phase-1-eval-linear-extra-time', 'phase-1-eval-linear-vs-residual-confirm']) {
+  const s = byId.get(id);
+  if (!s) { fail(`eval spec ${id}: present`, 'missing'); continue; }
+  check(`${id}: evalParams white=linear`, s.evalParams?.white === EVAL_LINEAR, `${s.evalParams?.white}`);
+  check(`${id}: evalParams black=pinned residual arm`, s.evalParams?.black === PINNED_RESIDUAL, `${s.evalParams?.black}`);
+}
+const primary = byId.get('phase-1-eval-linear-vs-residual');
+if (primary) {
+  const sides = sideOptions(primary);
+  check('primary eval: equal finite per-move time both sides', sides[0].timeMs === sides[1].timeMs && Number.isFinite(sides[0].timeMs), `white=${sides[0].timeMs} black=${sides[1].timeMs}`);
+  check('primary eval: no depth cap (practical time comparison)', sides.every(s => s.maxDepth === undefined), sides.map(s => `maxDepth=${s.maxDepth ?? '-'}`).join(' | '));
+}
+const sens = byId.get('phase-1-eval-linear-extra-time');
+if (sens) {
+  const sides = sideOptions(sens);
+  check('sensitivity arm: linear gets extra finite time, no depth cap', Number.isFinite(sides[0].timeMs) && sides[0].timeMs > sides[1].timeMs && sides[0].maxDepth === undefined,
+    `linear=${sides[0].timeMs} residual=${sides[1].timeMs}`);
+}
+// Confirmation runs are fixed independent samples with unseen seeds and fresh ids.
+const pilotSeeds = new Set(loaded.filter(l => !l.spec.id.endsWith('-confirm')).map(l => l.spec.seed));
+for (const l of loaded.filter(l => l.spec.id.endsWith('-confirm'))) {
+  check(`confirmation ${l.spec.id}: unseen seed`, !pilotSeeds.has(l.spec.seed), `seed=${l.spec.seed}`);
+}
+
+// ---------------------------------------------------------------------------------------------
+// 2b. Budget ledger: physical GameRecords counted once, <= 10000, aligned with the JSON games.
+
+interface LedgerRun { id: string; kind: string; specGames: number; pilot: number; cap: number; confirm: number }
+const ledger = JSON.parse(readFileSync(LEDGER, 'utf8')) as {
+  phaseGamesCap: number; runs: LedgerRun[];
+  totals: { throughputProbe: number; pilot: number; pilotIncludingProbes: number; expansionAdditions: number; confirmation: number; planned: number; reserve: number };
+};
+const ledgerById = new Map(ledger.runs.map(r => [r.id, r]));
+check('ledger: unique run ids', ledgerById.size === ledger.runs.length, `${ledger.runs.length}`);
+const specIds = new Set(loaded.map(l => l.spec.id));
+check('ledger: every spec id has a ledger row', [...specIds].every(id => ledgerById.has(id)), [...specIds].filter(id => !ledgerById.has(id)).join(',') || 'all');
+check('ledger: every ledger row has a spec', [...ledgerById.keys()].every(id => specIds.has(id)), [...ledgerById.keys()].filter(id => !specIds.has(id)).join(',') || 'all');
+let gamesMismatch = 0;
+for (const l of loaded) {
+  const row = ledgerById.get(l.spec.id);
+  if (!row || row.specGames !== l.spec.games) gamesMismatch++;
+}
+check('ledger: spec games == ledger specGames', gamesMismatch === 0, `mismatches=${gamesMismatch}`);
+const recomputedPlanned = ledger.runs.reduce((a, r) => a + r.cap, 0);
+const recomputedConfirm = ledger.runs.reduce((a, r) => a + r.confirm, 0);
+check('ledger: planned == sum of caps and <= phase cap', recomputedPlanned === ledger.totals.planned && recomputedPlanned <= ledger.phaseGamesCap,
+  `planned=${recomputedPlanned} cap=${ledger.phaseGamesCap}`);
+check('ledger: confirmation total matches rows', recomputedConfirm === ledger.totals.confirmation, `${recomputedConfirm}`);
+check('ledger: reserve is unspent (planned + reserve == cap)', ledger.totals.planned + ledger.totals.reserve === ledger.phaseGamesCap,
+  `planned=${ledger.totals.planned} reserve=${ledger.totals.reserve}`);
+check('ledger: primary evaluator is one run id of physical records (not doubled per side)',
+  ledger.runs.filter(r => r.kind === 'evaluator-head-to-head').length === 1 && ledgerById.get('phase-1-eval-linear-vs-residual')?.cap === 1600,
+  `head-to-head rows=${ledger.runs.filter(r => r.kind === 'evaluator-head-to-head').length} cap=${ledgerById.get('phase-1-eval-linear-vs-residual')?.cap}`);
+
+// ---------------------------------------------------------------------------------------------
+// 3. Residual evaluator: is a real blob present, and does the executable path use it?
+
+const src = sourceId('.');
+check('identity: sourceId is stable non-empty', /^[0-9a-f]{12}$/.test(src), src);
+for (const l of loaded) check(`${l.file}: specKey`, /^[0-9a-f]{12}$/.test(l.key), l.key);
+
+check('residual: weights.ts holds a net', netLoaded === true, `netLoaded=${netLoaded}`);
+check('residual: kind is residual', netKind() === 'residual' && NET_KIND === 'residual', `${netKind()}/${NET_KIND}`);
+check('residual: blob is not a placeholder', NET_B64.length > 100000 && !/^(0+|A+)$/.test(NET_B64.slice(0, 32)), `b64len=${NET_B64.length}`);
+
+// Re-quantise sim/nnue/net.json exactly as src/sim/gen.ts does and compare to the committed blob.
+const putW = (w: Int16Array, x: number, o: number): number => { const q = Math.round(x); if (q > W_MAX || q < -W_MAX) throw new Error('out of Int16 range'); w[o] = q; return o + 1; };
+const netJson = JSON.parse(readFileSync(NET_JSON, 'utf8')) as { w1: number[]; b1: number[]; w2: number[]; b2: number; opts?: { loss?: string } };
+const q = new Int16Array(N_WEIGHTS);
+let o = 0;
+for (let i = 0; i < INPUTS * HIDDEN; i++) o = putW(q, netJson.w1[i] * QA, o);
+for (let i = 0; i < HIDDEN; i++) o = putW(q, netJson.b1[i] * QA, o);
+for (let i = 0; i < 2 * HIDDEN; i++) o = putW(q, netJson.w2[i] * QB, o);
+putW(q, netJson.b2 * QB, o);
+const requantised = packNet(q);
+check('residual: committed blob matches the accepted Q6 model sha', sha(NET_B64) === Q6_ACCEPTED_SHA,
+  `sha256(b64)=${sha(NET_B64).slice(0, 24)}…`);
+if (requantised === NET_B64) {
+  notes.push('residual: sim/nnue/net.json re-quantises to the committed blob (candidate == adopted).');
+} else {
+  notes.push(`residual GATE: sim/nnue/net.json re-quantises to ${sha(requantised).slice(0, 16)}…, NOT the committed blob ${sha(NET_B64).slice(0, 16)}… (net.json loss=${netJson.opts?.loss}). \`tsx src/sim/gen.ts arms\` would therefore pin a different net than the one adopted in src/ai/nnue/weights.ts. Do not regenerate the arm files without resolving this.`);
+}
+
+// The executable path defaults to linear in the simulation worker; evalParams switches a run.
+check('evaluator: simulation default is linear', evaluatorName() === 'linear', evaluatorName());
+setRules({}); // the sim runner sets the spec's rules; defaults are the current game
+let deltaMax = 0, deltaSum = 0, nonZero = 0, over = 0, labDelta = 0;
+setEvaluator('residual');
+for (const s of setups) {
+  const pos = fromFen(s.fen);
+  const lin = evaluateBoard(pos.board, pos.turn);
+  const res = evalBoard(pos.board, pos.turn);
+  const d = Math.abs(res - lin);
+  if (d > 0) nonZero++;
+  if (d > RESIDUAL_MAX + 1) over++;
+  deltaMax = Math.max(deltaMax, d); deltaSum += d;
+}
+const lab = fromFen('4k3/8/8/8/8/8/8/4K1O1 w - - 0 1');
+labDelta = evalBoard(lab.board, lab.turn) - evaluateBoard(lab.board, lab.turn);
+check('residual: applied on current-game setups (no lab fallback)', nonZero > 0 && over === 0,
+  `nonzero=${nonZero}/${setups.length} mean|Δ|=${(deltaSum / setups.length).toFixed(2)} max=${deltaMax} overClip=${over}`);
+check('residual: lab piece falls back to linear (documented, not residual evidence)', labDelta === 0, `Ogre position Δ=${labDelta}`);
+
+// eval-residual.json drives setEvalParams; it carries evaluator=residual and (currently) no net field.
+const evRes = JSON.parse(readFileSync(EVAL_RESIDUAL, 'utf8')) as EvalParams;
+const evLin = JSON.parse(readFileSync(EVAL_LINEAR, 'utf8')) as EvalParams;
+setEvalParams(evLin);
+check('eval-linear.json: loads linear', evaluatorName() === 'linear', evaluatorName());
+setEvalParams(evRes);
+check('eval-residual.json: loads residual', evaluatorName() === 'residual', evaluatorName());
+const evResRaw = JSON.parse(readFileSync(EVAL_RESIDUAL, 'utf8')) as { net?: unknown };
+check('eval-residual.json: net field state recorded', true, evResRaw.net ? 'pinned blob present' : 'NO net field — the arm relies on src/ai/nnue/weights.ts, which sourceId pins');
+if (!evResRaw.net) {
+  notes.push('residual: sim/nnue/eval-residual.json has no `net` field (repository arm file), so it relies on src/ai/nnue/weights.ts. The campaign-owned pinned arm below embeds the exact committed blob instead.');
+}
+
+const pinned = JSON.parse(readFileSync(PINNED_RESIDUAL, 'utf8')) as EvalParams & { net?: { b64?: string; kind?: string } };
+check('pinned arm: evaluator residual + kind residual', pinned.evaluator === 'residual' && pinned.net?.kind === 'residual', `${pinned.evaluator}/${pinned.net?.kind}`);
+check('pinned arm: embeds the committed blob bytes', pinned.net?.b64 === NET_B64, `len=${pinned.net?.b64?.length} vs ${NET_B64.length}`);
+check('pinned arm: blob sha matches accepted Q6 model', !!pinned.net?.b64 && sha(pinned.net.b64) === Q6_ACCEPTED_SHA, `sha256=${pinned.net?.b64 ? sha(pinned.net.b64).slice(0, 24) : 'none'}…`);
+setEvalParams(pinned);
+check('pinned arm: loads as residual', evaluatorName() === 'residual', evaluatorName());
+setEvaluator('linear'); // leave the module as the sim worker sees it
+
+// ---------------------------------------------------------------------------------------------
+// Report.
+
+const failed = results.filter(r => !r.ok);
+console.log('\n=== phase-1 protocol/setup validation ===\n');
+for (const r of results) console.log(`${r.ok ? 'PASS' : 'FAIL'}  ${r.name}${r.detail ? `  [${r.detail}]` : ''}`);
+console.log(`\nsourceId=${src}`);
+for (const l of loaded) console.log(`  ${l.spec.id}: games=${l.spec.games} configs=${l.spec.asymmetric?.length} specKey=${l.key}`);
+console.log(`\n${results.length - failed.length}/${results.length} checks passed`);
+if (failed.length) {
+  console.log('\nFAILURES:');
+  for (const r of failed) console.log(`  - ${r.name}: ${r.detail}`);
+  process.exitCode = 1;
+}
