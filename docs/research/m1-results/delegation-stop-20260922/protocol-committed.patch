+/**
+ * Deterministic generator for the PHASE 1 setup/spec package. Re-running it reproduces
+ * campaign/setups/phase-1.json, campaign/specs/phase-1-*.proposed.json, the budget ledger and the
+ * pinned residual arm byte for byte. It never searches, never plays a game and never reads a
+ * credential.
+ *
+ *   node_modules/.bin/tsx campaign/setups/phase-1-generate.ts
+ *
+ * Budget note (supervisor correction 2026-09-22): every run is time-based with an explicit finite
+ * `timeMs` per move and no depth cap on the primary comparison. `PILOT_T_MS` is a PROVISIONAL
+ * candidate; the reviewed M1 throughput pilot selects the real value. The JSON files are the frozen
+ * artifacts; a launch must use them (or reviewed copies with fresh ids), never a `--depth` shortcut.
+ */
+import { mkdirSync, writeFileSync } from 'node:fs';
+import { mulberry32 } from '../../src/sim/rng';
+import { sampleBackRank } from '../../src/sim/spec';
+import { POOL } from '../../src/rules/setup';
+import { evalParams } from '../../src/ai/eval';
+import { NET_B64 } from '../../src/ai/nnue/weights';
+
+const SEED = 20260922;
+const MIRROR = 64;
+const ASYM = 32;
+/** PROVISIONAL per-move time candidates (ms). The M1 throughput pilot selects the real pair. */
+const PROBE_T_MS = [50, 100, 200];
+const PILOT_T_MS = 100; // placeholder for the main arms; pending the pilot
+const SENS_T_MS = 400;  // the linear side of the cost-sensitivity arm: 4x, with a finite guard
+const PINNED_RESIDUAL = 'campaign/specs/phase-1-residual-eval.json';
+
+const rng = mulberry32(SEED);
+const seen = new Set<string>();
+const ranks: string[] = [];
+while (ranks.length < MIRROR + ASYM * 2) {
+  const r = sampleBackRank(rng);
+  if (seen.has(r)) continue;
+  seen.add(r);
+  ranks.push(r);
+}
+
+const startFen = (whiteRank: string, blackRank: string): string =>
+  `${blackRank.toLowerCase()}/pppppppp/8/8/8/8/PPPPPPPP/${whiteRank} w - - 0 1`;
+
+interface Setup {
+  id: string;
+  kind: 'mirror-start' | 'asymmetric-start';
+  white: { backRank: string; composition: string };
+  black: { backRank: string; composition: string };
+  fen: string;
+  fenSwapped: string;
+  hasArcherEitherSide: boolean;
+  hasBeastEitherSide: boolean;
+  hasGuardEitherSide: boolean;
+  bothHaveArcher: boolean;
+  bothHaveBeast: boolean;
+}
+
+const kinds = (rank: string): string => [...new Set(rank.split('').filter(c => c !== 'K'))].sort().join('');
+const setups: Setup[] = [];
+let n = 0;
+const push = (kind: Setup['kind'], wr: string, br: string): void => {
+  n++;
+  setups.push({
+    id: `P1-${String(n).padStart(3, '0')}`,
+    kind,
+    white: { backRank: wr, composition: kinds(wr) },
+    black: { backRank: br, composition: kinds(br) },
+    fen: startFen(wr, br),
+    fenSwapped: startFen(br, wr),
+    hasArcherEitherSide: wr.includes('A') || br.includes('A'),
+    hasBeastEitherSide: wr.includes('S') || br.includes('S'),
+    hasGuardEitherSide: wr.includes('G') || br.includes('G'),
+    bothHaveArcher: wr.includes('A') && br.includes('A'),
+    bothHaveBeast: wr.includes('S') && br.includes('S'),
+  });
+};
+for (let i = 0; i < MIRROR; i++) push('mirror-start', ranks[i], ranks[i]);
+for (let i = 0; i < ASYM; i++) push('asymmetric-start', ranks[MIRROR + 2 * i], ranks[MIRROR + 2 * i + 1]);
+
+const LETTERS9 = 'QRLBNAGMS'.split('');
+const letterCounts = (side: 'white' | 'black'): Record<string, number> => {
+  const c: Record<string, number> = Object.fromEntries(LETTERS9.map(l => [l, 0]));
+  for (const s of setups) for (const ch of s[side].backRank) if (c[ch] !== undefined) c[ch]++;
+  return c;
+};
+for (const l of LETTERS9) if ((letterCounts('white')[l] ?? 0) < 10) throw new Error(`coverage: white ${l} too rare`);
+const compositionCounts: Record<string, number> = {};
+for (const s of setups) compositionCounts[s.white.composition] = (compositionCounts[s.white.composition] ?? 0) + 1;
+
+const coverage = {
+  total: setups.length,
+  byKind: { 'mirror-start': MIRROR, 'asymmetric-start': ASYM },
+  distinctWhiteCompositions: Object.keys(compositionCounts).length,
+  topWhiteCompositions: Object.entries(compositionCounts).sort((a, b) => b[1] - a[1]).slice(0, 10),
+  whiteLetterCounts: letterCounts('white'),
+  blackLetterCounts: letterCounts('black'),
+  bothHaveArcher: setups.filter(s => s.bothHaveArcher).length,
+  bothHaveBeast: setups.filter(s => s.bothHaveBeast).length,
+  guardEitherSide: setups.filter(s => s.hasGuardEitherSide).length,
+  asymmetricFenSwappedDiffers: setups.filter(s => s.fen !== s.fenSwapped).length,
+};
+
+const setupsFile = {
+  schema: 'phase-1-setups/v1',
+  generatedAt: '2026-09-22',
+  generator: 'campaign/setups/phase-1-generate.ts',
+  pool: POOL,
+  selection: {
+    prng: 'mulberry32',
+    seed: SEED,
+    procedure: `sample ${MIRROR + ASYM * 2} distinct back ranks with src/sim/spec.ts sampleBackRank (7 of POOL + K, bishops on opposite colours); ranks 0..${MIRROR - 1} become mirror starts (white rank == black rank); ranks ${MIRROR}..${MIRROR + ASYM * 2 - 1} are paired (2k, 2k+1) into ${ASYM} asymmetric starts (white rank, black rank).`,
+    pawns: 'every setup uses pawns on ranks 2 and 7 and no other pieces; the top half of the back rank is the lowercase mirror of the bottom half (src/rules/setup.ts startPosition)',
+  },
+  mirrorRule: {
+    fenSwapped: 'flip the board rank order (r -> 7-r) and swap piece case, keeping White to move; this is the colour-and-rank mirror that hands the same structure to the other army',
+    selfMirroring: 'a mirror start is invariant under the mirror, so fenSwapped == fen; an asymmetric start maps to the other army, so fenSwapped != fen',
+    duplicateWarning: 'for a single-engine arm (same settings both sides) a mirror start gives two orientation records that replay the same game when the openings coincide; they are one independent unit, not two. See the ledger and the independent-unit accounting in campaign/verify-phase-1.ts.',
+  },
+  pairColorMapping: {
+    engine: 'src/sim/spec.ts buildJobs with RunSpec.pairs=true and RunSpec.asymmetric[]',
+    rule: 'buildJobs sets config = asymmetric[pairId % asymmetric.length], so pair k uses setup (k mod N), where N is the number of listed setups and pairId = k. Game 2k uses that setup\'s fen with the spec\'s white AI config on White; game 2k+1 uses its fenSwapped with the same config on Black. Pairs repeat the setup list when games/2 > N.',
+    openings: 'commonSeeds=true gives every pair the same opening RNG stream, but it does NOT guarantee identical played openings: a rule that changes the legal-move set (e.g. archerShots) can make the random opening choose different moves. Claim equal seeds, not equal positions.',
+    independentUnits: 'an independent unit is (setup, opening stream). The two orientations of a mirror start under a single-engine arm are not independent. Report both physical records and independent units.',
+  },
+  coverage,
+  setups,
+};
+mkdirSync('campaign/setups', { recursive: true });
+writeFileSync('campaign/setups/phase-1.json', JSON.stringify(setupsFile, null, 2) + '\n');
+
+// ---- pinned residual arm ---------------------------------------------------------------------
+// Copies the exact accepted Q6 blob bytes from src/ai/nnue/weights.ts into the existing EvalParams
+// format. It copies the blob; it does not train or replace weights.
+mkdirSync('campaign/specs', { recursive: true });
+const live = evalParams();
+const pinnedArm = { ...live, evaluator: 'residual', net: { b64: NET_B64, kind: 'residual' } };
+writeFileSync(PINNED_RESIDUAL, JSON.stringify(pinnedArm, null, 1) + '\n');
+
+// ---- proposed specs --------------------------------------------------------------------------
+const all = setups;
+const archerSet = setups.filter(s => s.bothHaveArcher);
+const beastSet = setups.filter(s => s.bothHaveBeast);
+const asym = (ss: Setup[]) => ss.map(s => ({ white: s.white.backRank, black: s.black.backRank, fen: s.fen, fenSwapped: s.fenSwapped }));
+
+const frozenRules = {
+  archerMove: 'any',
+  archerShots: 'plusDiagFwd2',
+  archerChecks: true,
+  beastMove: 'any',
+  beastCapture: 'adjacent',
+  beastCaptureForward: true,
+  beastChains: true,
+  guardImmune: true,
+  guardCaptures: 'none',
+  guardStep: 1,
+  promotionSet: 'standard',
+  paladinKamikaze: 'nonPawn',
+  bishopsOppositeColours: true,
+  fiftyMove: true,
+  threefold: true,
+  insufficientMaterial: true,
+};
+
+const PROPOSED = 'PROPOSED — per-move timeMs is a provisional candidate; the reviewed M1 throughput pilot selects the confirmed value and a reviewed frozen copy is made before launch. No game has been played.';
+
+const common = (id: string, ss: Setup[], games: number, seed: number, ai: Record<string, unknown>) => ({
+  id,
+  games,
+  asymmetric: asym(ss),
+  commonSeeds: true,
+  pairs: true,
+  ai,
+  openingRandomPlies: 4,
+  maxPlies: 300,
+  adjudicate: false,
+  seed,
+  _status: PROPOSED,
+});
+
+const specs: Record<string, unknown> = {};
+for (const t of PROBE_T_MS) {
+  specs[`phase-1-throughput-t${t}.proposed.json`] = {
+    ...common(`phase-1-throughput-t${t}`, setups.slice(0, 12), 24, 8105 + t, { timeMs: t }),
+    _arm: `throughput probe at ${t} ms/move (no depth cap)`,
+    _measures: 'games/s, nodes/s, reached depth, mean plies, cap share and per-evaluator cost; the supervisor selects the confirmed per-move time from the probes',
+  };
+}
+specs['phase-1-archer-adopted.proposed.json'] = {
+  ...common('phase-1-archer-adopted', archerSet, 400, 8101, { timeMs: PILOT_T_MS }),
+  rules: { ...frozenRules, archerShots: 'plusDiagFwd2' },
+  _arm: 'current adopted archer (forward diagonal-2 on top of classic); all other rules frozen',
+  _expandTo: 'expand games to the ledger cap (1600) in place; buildJobs is a prefix, so the first 400 games are not replayed',
+};
+specs['phase-1-archer-classic.proposed.json'] = {
+  ...common('phase-1-archer-classic', archerSet, 400, 8101, { timeMs: PILOT_T_MS }),
+  rules: { ...frozenRules, archerShots: 'classic' },
+  _arm: 'exact-classic archer shots; Beast, promotions, values and every other setting identical to the adopted arm',
+  _expandTo: 'expand games to the ledger cap (1600) in place; same setups and seed as the adopted arm',
+};
+specs['phase-1-eval-linear-vs-residual.proposed.json'] = {
+  ...common('phase-1-eval-linear-vs-residual', all, 400, 8102, { timeMs: PILOT_T_MS }),
+  evalParams: { white: 'sim/nnue/eval-linear.json', black: PINNED_RESIDUAL },
+  rules: { ...frozenRules },
+  _arm: 'primary head-to-head, per-side evaluations at equal per-move time: White=linear, Black=residual in game 2k and swapped in game 2k+1 (pairs=true). No depth cap.',
+  _cost: 'equal per-move time allowance; both sides use evalParams so the swap overhead is identical; reached depth and actual nodes/ms are recorded per move',
+  _expandTo: 'expand games to the ledger cap (1600) in place',
+};
+specs['phase-1-eval-linear-extra-time.proposed.json'] = {
+  ...common('phase-1-eval-linear-extra-time', all, 400, 8103, { white: { timeMs: SENS_T_MS }, black: { timeMs: PILOT_T_MS } }),
+  evalParams: { white: 'sim/nnue/eval-linear.json', black: PINNED_RESIDUAL },
+  rules: { ...frozenRules },
+  _arm: 'cost-sensitivity arm: linear gets 4x the per-move time of residual, both with a finite guard. This is sensitivity evidence, not proof of a mechanism.',
+  _expandTo: 'expand games to the ledger cap (800) in place',
+};
+specs['phase-1-beast-guard-focus.proposed.json'] = {
+  ...common('phase-1-beast-guard-focus', beastSet, 200, 8104, { timeMs: PILOT_T_MS }),
+  rules: { ...frozenRules },
+  _arm: 'both armies carry a Beast: telemetry for Beast chains and Guard blocks; descriptive, not a confirmatory test',
+  _expandTo: 'expand games to the ledger cap (400) in place',
+};
+specs['phase-1-archer-adopted-confirm.proposed.json'] = {
+  ...common('phase-1-archer-adopted-confirm', archerSet, 800, 8201, { timeMs: PILOT_T_MS }),
+  rules: { ...frozenRules, archerShots: 'plusDiagFwd2' },
+  _arm: 'fixed independent confirmation sample, unseen seed 8201',
+};
+specs['phase-1-archer-classic-confirm.proposed.json'] = {
+  ...common('phase-1-archer-classic-confirm', archerSet, 800, 8201, { timeMs: PILOT_T_MS }),
+  rules: { ...frozenRules, archerShots: 'classic' },
+  _arm: 'fixed independent confirmation sample, unseen seed 8201',
+};
+specs['phase-1-eval-linear-vs-residual-confirm.proposed.json'] = {
+  ...common('phase-1-eval-linear-vs-residual-confirm', all, 800, 8202, { timeMs: PILOT_T_MS }),
+  evalParams: { white: 'sim/nnue/eval-linear.json', black: PINNED_RESIDUAL },
+  rules: { ...frozenRules },
+  _arm: 'fixed independent confirmation sample, unseen seed 8202',
+};
+for (const [file, spec] of Object.entries(specs)) writeFileSync(`campaign/specs/${file}`, JSON.stringify(spec, null, 2) + '\n');
+
+// ---- budget ledger ---------------------------------------------------------------------------
+// One entry per unique run id. `specGames` is the `games` value in the frozen JSON; `cap` is the
+// physical-game ceiling after in-place expansion; `confirm` is the fixed unseen-seed sample for a
+// separate run id. Physical games are counted once: an N-game head-to-head match is N records and
+// each evaluation participates in all N.
+const runs = [
+  ...PROBE_T_MS.map(t => ({ id: `phase-1-throughput-t${t}`, kind: 'throughput-probe', specGames: 24, pilot: 24, cap: 24, confirm: 0 })),
+  { id: 'phase-1-archer-adopted', kind: 'rule-population', specGames: 400, pilot: 400, cap: 1600, confirm: 0 },
+  { id: 'phase-1-archer-classic', kind: 'rule-population', specGames: 400, pilot: 400, cap: 1600, confirm: 0 },
+  { id: 'phase-1-eval-linear-vs-residual', kind: 'evaluator-head-to-head', specGames: 400, pilot: 400, cap: 1600, confirm: 0 },
+  { id: 'phase-1-eval-linear-extra-time', kind: 'evaluator-sensitivity', specGames: 400, pilot: 400, cap: 800, confirm: 0 },
+  { id: 'phase-1-beast-guard-focus', kind: 'descriptive', specGames: 200, pilot: 200, cap: 400, confirm: 0 },
+  { id: 'phase-1-archer-adopted-confirm', kind: 'confirmation', specGames: 800, pilot: 0, cap: 800, confirm: 800 },
+  { id: 'phase-1-archer-classic-confirm', kind: 'confirmation', specGames: 800, pilot: 0, cap: 800, confirm: 800 },
+  { id: 'phase-1-eval-linear-vs-residual-confirm', kind: 'confirmation', specGames: 800, pilot: 0, cap: 800, confirm: 800 },
+];
+const probe = runs.filter(r => r.kind === 'throughput-probe').reduce((a, r) => a + r.cap, 0);
+const pilot = runs.filter(r => r.kind !== 'throughput-probe').reduce((a, r) => a + r.pilot, 0);
+const planned = runs.reduce((a, r) => a + r.cap, 0);
+const confirmation = runs.reduce((a, r) => a + r.confirm, 0);
+// Expansion additions are the extra games beyond each non-probe, non-confirmation pilot.
+const expansion = runs.filter(r => r.pilot > 0 && r.confirm === 0).reduce((a, r) => a + (r.cap - r.pilot), 0);
+const cap = 10000;
+const ledger = {
+  schema: 'phase-1-budget-ledger/v1',
+  note: 'Physical GameRecords, counted once. An N-game head-to-head match is N records; each evaluation participates in all N. Reserve is a ceiling, not a target and is not spent for being available.',
+  phaseGamesCap: cap,
+  runs,
+  totals: {
+    throughputProbe: probe, pilot, pilotIncludingProbes: pilot + probe,
+    expansionAdditions: expansion, confirmation, planned, reserve: cap - planned,
+  },
+  perMoveTimeMs: { provisionalCandidates: PROBE_T_MS, selected: null, sensitivityArm: SENS_T_MS },
+};
+writeFileSync('campaign/specs/phase-1-budget-ledger.json', JSON.stringify(ledger, null, 2) + '\n');
+
+console.log(`setups: ${setups.length} (${MIRROR} mirror, ${ASYM} asymmetric); archer-both ${archerSet.length}; beast-both ${beastSet.length}`);
+console.log(`pinned residual arm: ${PINNED_RESIDUAL} (b64 ${NET_B64.length} chars)`);
+console.log(`ledger: throughput ${probe}, pilot ${pilot}, expansion ${expansion}, confirmation ${confirmation}, planned ${planned}, reserve ${cap - planned}`);
+console.log('specs:', Object.keys(specs).join(', '));
