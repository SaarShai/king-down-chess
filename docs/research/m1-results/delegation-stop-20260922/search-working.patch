+/** TEMP DIAGNOSTIC. */
+export const qRep = { hitsPath: 0, hitsHist: 0, cuts: 0, minDist: 999, hmAtHit: 0 };
+
+/**
+ * Repetition test for quiescence. `repeated` bounds its path scan with the halfmove clock, but
+ * that bound is unsound in this variant: an ogre shove (or maester swap) can move a pawn back, so
+ * the same position can recur across a ply that reset the clock. Quiescence can therefore repeat
+ * without `hm` ever being large enough to see it. Scan the whole path instead; a matching key is a
+ * genuine two-fold (same board, turn and strike), so no window is needed.
+ */
+function repeatedQ(ply: number, hm: number, key: number): boolean {
+  for (let i = ply - 2; i >= 0; i -= 2) if (path[i] === key) {
+    qRep.hitsPath++; qRep.minDist = Math.min(qRep.minDist, ply - i); qRep.hmAtHit = hm;
+    return true;
+  }
+  const n = gameHistory.length;
+  for (let i = n - 1; i >= 0; i--) if (gameHistory[i] === key) { qRep.hitsHist++; return true; }
+  return false;
+}
