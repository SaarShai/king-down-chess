+// Source/spec provenance for a paired comparison. Identity records are synthetic, not played
+// games. `identifyArm` rejects internal mixing; `qualifyPair` rejects a differing known source id
+// but reports a differing specKey/rulesKey with an explicit review requirement.
+const ident = (field: IdentityField, value?: string): IdentityRecord =>
+  (value === undefined ? {} : { [field]: value }) as IdentityRecord;
+
+const pairRec = (gameId: number, result: 1 | 0.5 | 0, id: Partial<Record<IdentityField, string>> = {}): GameRecord =>
+  Object.assign(
+    {},
+    mkRec(gameId, 'a6k/8/8/8/8/8/8/A5AK w - - 0 1',
+      [{ A: 2, K: 1 }, { A: 1, K: 1 }], [{ A: 1 }, { A: 1 }],
+      [{ A: 1, K: 1 }, { A: 1, K: 1 }], [{ A: 0 }, { A: 0 }],
+      result, 'checkmate', 10),
+    id,
+  ) as GameRecord;
+
+describe('conditions provenance validation seam', () => {
+  it('rejects a different value or a missing/present mixture for every identity field', () => {
+    for (const field of ['src', 'specKey', 'rulesKey'] as IdentityField[]) {
+      expect(() => identifyArm('arm', [ident(field, 'a'), ident(field, 'b')]))
+        .toThrow(new RegExp(`different ${field} values`));
+      expect(() => identifyArm('arm', [ident(field, 'a'), ident(field)]))
+        .toThrow(new RegExp(`mixes missing and present ${field}`));
+    }
+  });
+
+  it('rejects present non-string, empty and whitespace-only values, but lets null stay legacy', () => {
+    for (const field of ['src', 'specKey', 'rulesKey'] as IdentityField[]) {
+      expect(() => identifyArm('arm', [{ [field]: 7 } as IdentityRecord]))
+        .toThrow(new RegExp(`non-string ${field}`));
+      expect(() => identifyArm('arm', [{ [field]: '' } as IdentityRecord]))
+        .toThrow(new RegExp(`blank ${field}`));
+      expect(() => identifyArm('arm', [{ [field]: '   ' } as IdentityRecord]))
+        .toThrow(new RegExp(`blank ${field}`));
+    }
+    const legacy = identifyArm('legacy', [{ src: null, specKey: null, rulesKey: null }, {}]);
+    expect(legacy.legacy).toBe(true);
