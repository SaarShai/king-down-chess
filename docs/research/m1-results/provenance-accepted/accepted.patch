+
+  it('reads a uniform arm, a uniformly partial arm and a fully missing legacy arm', () => {
+    const full = identifyArm('full', [ident('src', 's'), ident('src', 's')]);
+    expect(full.values).toEqual({ src: 's', specKey: null, rulesKey: null });
+    expect(full.legacy).toBe(false);
+
+    const partial = identifyArm('partial', [ident('specKey', 'p'), ident('specKey', 'p')]);
+    expect(partial.values.specKey).toBe('p');
