+/**
+ * Provenance of one arm: the top-level `src`, `specKey` and `rulesKey` a runner stamps on every
+ * line (see `run.ts` `Stamp`). `null` means every record in the arm omits the field, as a run
+ * written before stamping existed. A field present on only some records, or carrying more than one
+ * value, is an internally mixed arm: two experiments added up as one, which no paired read can fix.
+ */
+export const IDENTITY_FIELDS = ['src', 'specKey', 'rulesKey'] as const;
+export type IdentityField = (typeof IDENTITY_FIELDS)[number];
+
+export interface IdentityRecord {
+  src?: unknown;
+  specKey?: unknown;
+  rulesKey?: unknown;
+}
+
+export interface ArmIdentity {
+  id: string;
+  /** Uniform present value per field, or null when the whole arm omits it. */
+  values: Record<IdentityField, string | null>;
+  /** Every record omits every identity field (a fully unstamped legacy run). */
+  legacy: boolean;
+  games: number;
+}
+
+export function identifyArm(id: string, records: readonly IdentityRecord[]): ArmIdentity {
+  const values = {} as Record<IdentityField, string | null>;
+  let any = false;
+  for (const field of IDENTITY_FIELDS) {
+    const present: string[] = [];
+    for (const r of records) {
+      const v = r[field];
+      if (typeof v === 'string' && v) present.push(v);
+    }
+    if (present.length > 0 && present.length < records.length) {
+      throw new Error(`conditions: ${id} mixes missing and present ${field} values (${present.length}/${records.length} records carry it); a paired comparison needs one provenance per arm`);
+    }
+    const distinct = [...new Set(present)].sort();
+    if (distinct.length > 1) {
+      throw new Error(`conditions: ${id} carries ${distinct.length} different ${field} values (${distinct.join(', ')}); a paired comparison needs one provenance per arm`);
+    }
+    const value = distinct[0] ?? null;
+    values[field] = value;
+    if (value) any = true;
+  }
+  return { id, values, legacy: !any, games: records.length };
+}
+
+export interface PairProvenance {
+  a: ArmIdentity;
+  b: ArmIdentity;
+  /** Both arms carry a source id and both settings keys, so the comparison is identity-verified. */
+  verified: boolean;
+  notes: string[];
+}
+
+const fieldLine = (label: string, a: ArmIdentity, b: ArmIdentity, field: IdentityField): string =>
+  `${label} ${a.id}=${a.values[field] ?? 'MISSING'} ${b.id}=${b.values[field] ?? 'MISSING'}`;
+
+/**
+ * Identity qualification for a paired comparison. `identifyArm` already rejected an internally
+ * mixed arm. Here a different *known* source id across arms is a hard reject, because the two arms
+ * were then played by different engine code. A differing `specKey`/`rulesKey` is NOT rejected: an
+ * intended rule or evaluator treatment is exactly a differing rulesKey, and a differing specKey can
+ * be the intended evaluation input, so the caller gets the observed identities and an explicit
+ * review requirement instead. Missing identities never verify; they only yield UNVERIFIED status.
+ */
+export function qualifyPair(a: ArmIdentity, b: ArmIdentity): PairProvenance {
+  const notes: string[] = [];
+  const srcA = a.values.src, srcB = b.values.src;
+  if (srcA && srcB && srcA !== srcB) {
+    throw new Error(`conditions: ${a.id} source id ${srcA} differs from ${b.id} source id ${srcB}; arms played by different known sources cannot be paired`);
+  }
+  notes.push(`${fieldLine('source', a, b, 'src')}${srcA && srcB ? ' (match)' : ''}`);
+  notes.push(fieldLine('specKey', a, b, 'specKey'));
+  notes.push(fieldLine('rulesKey', a, b, 'rulesKey'));
+
+  const srcKnown = !!srcA && !!srcB;
+  const settingsKnown = !!a.values.specKey && !!b.values.specKey && !!a.values.rulesKey && !!b.values.rulesKey;
+  if (!srcKnown || !settingsKnown) {
+    const missing: string[] = [];
+    if (!srcKnown) missing.push(`source (${!srcA && !srcB ? `${a.id} and ${b.id}` : srcA ? b.id : a.id})`);
+    if (!a.values.specKey || !b.values.specKey) missing.push('specKey');
+    if (!a.values.rulesKey || !b.values.rulesKey) missing.push('rulesKey');
+    const legacy = a.legacy && b.legacy
+      ? ' Both arms are fully unstamped legacy runs.'
+      : a.legacy || b.legacy ? ' One arm is a fully unstamped legacy run.' : '';
+    notes.push(`UNVERIFIED PROVENANCE/SETTINGS: ${missing.join(', ')} missing on at least one arm; this paired comparison cannot claim same source or same settings.${legacy}`);
+  }
+
+  const differ: string[] = [];
+  if (a.values.specKey && b.values.specKey && a.values.specKey !== b.values.specKey) differ.push('specKey');
+  if (a.values.rulesKey && b.values.rulesKey && a.values.rulesKey !== b.values.rulesKey) differ.push('rulesKey');
+  if (differ.length) {
+    notes.push(`observed ${differ.join(' and ')} differ across the arms: legitimate only as an intended rule/evaluator treatment. Review the frozen specs to establish the intended differences and equal practical budgets; the hashes alone establish neither, and matching hashes alone do not prove matching practical cost.`);
+  } else if (settingsKnown) {
+    notes.push('observed settings hashes match, but equal hashes alone do not prove matching practical cost (budget); review the frozen specs before treating the arms as equal-budget.');
+  }
+  return { a, b, verified: srcKnown && settingsKnown, notes };
+}
