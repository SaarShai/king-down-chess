# No production server starts until enabled Supabase OAuth discovery and the
# client-specific access-token hook issue aud=<KINGDOWN_PLUGIN_ORIGIN>/mcp.
KINGDOWN_PLUGIN_ORIGIN=https://kingdown.dev
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
KINGDOWN_PLUGIN_OAUTH_CLIENT_IDS=YOUR_APPROVED_OAUTH_CLIENT_UUID
KINGDOWN_PLUGIN_DATABASE_URL=postgresql://your-server-role:your-password@your-database/your-database
KINGDOWN_PLUGIN_OAUTH_READY=0
KINGDOWN_INTERNAL_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# KINGDOWN_ENGINES_DATABASE_URL is a local read-only release input, not a production key.
# Keep RESEND_API_KEY and KINGDOWN_MAIL_FROM unset for this MVP.
# Legacy --configure-plugin uses only the original six keys, with the old origin and client.
# Local-only alternative: compiled server.mjs --local-dev with a disposable
# loopback database and http://127.0.0.1:3100 origin. No users are auto-created.
