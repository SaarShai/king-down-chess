{
  "name": "king-down-chess",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run && node --test \"docs/2d-first-pieces/**/*.test.mjs\"",
    "test:docs": "vitest run --passWithNoTests .docs.test.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "gate": "node tools/gate.mjs",
    "check:browser": "node tools/check.mjs",
    "sim": "tsx src/sim/run.ts",
    "sim:analyze": "tsx src/sim/analyze.ts",
    "balance:build": "tsx tools/build-balance.ts",
    "balance:check": "tsx tools/check-balance.ts",
    "tune": "tsx src/sim/tune.ts",
    "tune:apply": "tsx src/sim/tune.ts apply",
    "dashboard": "node tools/dashboard.mjs",
    "nnue": "tsx src/sim/gen.ts",
    "graphics:study": "vite --port 5190 --strictPort",
    "graphics:check": "node tools/graphics-prototype/verify.mjs",
    "graphics:check:cast": "node tools/graphics-prototype/verify_cast.mjs",
    "plugin:build:runtime": "node tools/plugin-runtime-build.mjs",
    "plugin:build:ui": "node tools/plugin-ui-build.mjs",
    "plugin:build": "node tools/plugin-server-build.mjs",
    "plugin:smoke": "node tools/plugin-runtime-smoke.mjs",
    "plugin:check:protocol": "tsx tools/plugin-protocol-check.ts",
    "plugin:db:init-test": "node tools/plugin-db/bootstrap-test.mjs",
    "plugin:db:migrate": "tsx tools/plugin-db/migrate.ts",
    "plugin:server:check": "node tools/plugin-server-check.mjs",
    "plugin:serve": "node plugin-server-dist/server.mjs",
    "plugin:build:vercel": "node tools/plugin-server-build.mjs --vercel"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.117.2",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "meshoptimizer": "1.2.0",
    "playwright": "^1.63.0",
    "sharp": "0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
