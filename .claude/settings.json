{
  "permissions": {
    "deny": [
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(pgrep -l *)",
      "Bash(pgrep -fl *)",
      "Bash(pgrep -lf *)",
      "Bash(pgrep -a *)",
      "Bash(ps aux *)",
      "Bash(ps -ef *)",
      "Bash(ps eww *)",
      "Read(//**/.secrets/**)",
      "Read(~/.config/typesafe/key)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cloud-setup.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tool-gate.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
