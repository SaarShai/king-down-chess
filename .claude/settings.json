{
  "permissions": {
    "deny": [
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(pgrep -l *)",
      "Bash(pgrep -fl *)",
      "Bash(pgrep -lf *)",
      "Bash(pgrep -a *)",
      "Bash(ps aux *)",
      "Bash(ps -ef *)",
      "Bash(ps eww *)",
      "Read(//**/.secrets/**)",
      "Read(~/.config/typesafe/key)"
    ],
    "ask": [
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(bunx vercel *)",
      "Bash(pnpm dlx vercel *)",
      "Bash(psql *)",
      "Bash(supabase *)",
      "Bash(gh workflow run *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cloud-setup.sh",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-facts.mjs",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-facts.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tool-gate.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__Claude_Browser__navigate|mcp__Claude_Browser__preview_start|mcp__Claude_Browser__browser_batch|mcp__remote-devices__Claude_Browser__navigate|mcp__remote-devices__Claude_Browser__preview_start|mcp__remote-devices__Claude_Browser__browser_batch|mcp__claude-in-chrome__navigate|mcp__claude-in-chrome__tabs_create_mcp|mcp__claude-in-chrome__browser_batch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tool-gate.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
