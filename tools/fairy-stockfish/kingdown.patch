+   if(s<0||color(p.board[s])==side)continue;s=step(s,Dirs[d][0],Dirs[d][1]);while(s>=0&&!p.board[s])s=step(s,Dirs[d][0],Dirs[d][1]);
+   if(s>=0&&color(p.board[s])!=side&&type(p.board[s])!=KD_K&&can_capture(pc,type(p.board[s]),c))out.push_back(action(from,from,bit(s)));}
