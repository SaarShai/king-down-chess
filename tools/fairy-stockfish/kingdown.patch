+bool plain_reach(KdAction a,int from,int to) {return kd_from(a)==from&&kd_to(a)==to&&to!=from&&!kd_swap(a)&&!kd_shove(a)&&!kd_self_remove(a)&&(!a.victims||a.victims==bit(to));}
+bool owns_reach(const std::vector<KdAction>& base,int from,int to) {for(auto a:base)if(plain_reach(a,from,to))return true;return false;}
+bool first_copy(const KdPosition& p,const KdConfig& c,int side,int k) {for(int j=0;j<k;++j)if(card_at(c,side,j)==card_at(c,side,k)&&!(p.used[side]>>j&1))return false;return true;}
