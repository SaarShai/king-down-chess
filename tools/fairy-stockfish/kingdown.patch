+// Compound effects preserve every piece's promotion metadata.
+void Position::kingdown_apply(Move m) {
+  Square from = from_sq(m), to = to_sq(m);
+  Piece mover = piece_on(from), base = unpromotedBoard[from];
+  bool promoted = is_promoted(from);
+  Bitboard victims = is_kingdown_action(m) ? Bitboard(m.victims) : (empty(to) ? Bitboard(0) : square_bb(to));
+  for (Bitboard b = victims; b;) remove_piece(pop_lsb(b));
+  if (type_of(m) == KD_SHOT) return;
+  if (type_of(m) == KD_SWAP || type_of(m) == KD_PUSH) {
+    Piece other = piece_on(to), otherBase = unpromotedBoard[to];
+    bool otherPromoted = is_promoted(to);
+    remove_piece(to);
+    remove_piece(from);
+    put_piece(other, type_of(m) == KD_SWAP ? from : gating_square(m), otherPromoted, otherBase);
+  } else remove_piece(from);
+  if (type_of(m) != KD_REMOVE)
+    put_piece(type_of(m) == PROMOTION ? make_piece(sideToMove, promotion_type(m)) : mover,
