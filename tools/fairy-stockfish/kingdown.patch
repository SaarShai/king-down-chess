+   for(const auto& d:Dirs)for(int to=step(s,d[0],d[1]);to>=0;to=step(to,d[0],d[1])){int v=p.board[to];if(!v){if(power==KD_STRIKE&&!c.strikeCapture)out.push_back(action(s,to,0,power));continue;}
