+// Fixed base-piece geometry shared by generation and attack checks.
+#ifndef KINGDOWN_H_INCLUDED
+#define KINGDOWN_H_INCLUDED
+#include "types.h"
+namespace Stockfish {
+inline Square kd_step(Square s, int df, int dr) {
+  int f = int(file_of(s)) + df, r = int(rank_of(s)) + dr;
+  return f >= 0 && f < 8 && r >= 0 && r < 8 ? make_square(File(f), Rank(r)) : SQ_NONE;
+}
+inline bool kd_capital(Square s) {
+  return (file_of(s) == FILE_D || file_of(s) == FILE_E) && (rank_of(s) == RANK_4 || rank_of(s) == RANK_5);
+}
+inline bool kd_can_capture(PieceType attacker, PieceType victim) {
+  return attacker != KD_GUARD && (victim != KD_GUARD || attacker == KING)
+      && (victim != KING || attacker != KD_PALADIN);
+}
+}
+#endif
