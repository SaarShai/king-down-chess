+  if(!dark)for(int df:{-1,1}) {int to=step(from,df,dr);if(to>=0&&p.board[to]&&color(p.board[to])!=side&&type(p.board[to])!=KD_K&&can_capture(pc,type(p.board[to]),c))pawn_move(out,from,to,side,bit(to));}
