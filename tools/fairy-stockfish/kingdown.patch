+namespace {
+void kd_chain(const Position& pos, std::vector<ExtMove>& moves, Square from, Square at,
+              Bitboard victims, std::set<std::pair<uint64_t, int>>& seen) {
+  Bitboard targets = attacks_bb<KING>(at) & pos.pieces(~pos.side_to_move())
+                   & ~pos.pieces(KING) & ~pos.pieces(KD_GUARD) & ~victims;
+  while (targets) {
+    Square to = pop_lsb(targets);
+    Bitboard next = victims | to;
+    if (!seen.emplace(uint64_t(next), int(to)).second) continue;
+    moves.push_back({make_kingdown(KD_CHAIN, from, to, next), 0});
+    kd_chain(pos, moves, from, to, next, seen);
+  }
+}
+void kd_generate(const Position& pos, std::vector<ExtMove>& moves) {
+  Color us = pos.side_to_move();
+  auto add = [&](Move m) { moves.push_back({m, 0}); };
+  for (Bitboard b = pos.pieces(us); b;) {
+    Square from = pop_lsb(b);
+    PieceType pt = type_of(pos.piece_on(from));
+    if (pt == PAWN) {
+      int dr = us == WHITE ? 1 : -1;
+      auto pawn = [&](Square to) {
+        if (rank_of(to) == (us == WHITE ? RANK_8 : RANK_1))
+          for (PieceType promotion : {KNIGHT, BISHOP, ROOK, QUEEN}) add(make<PROMOTION>(from, to, promotion));
+        else add(make_move(from, to));
+      };
+      Square one = kd_step(from, 0, dr);
+      if (is_ok(one) && pos.empty(one)) {
+        pawn(one);
+        Square two = kd_step(one, 0, dr);
+        if (rank_of(from) == (us == WHITE ? RANK_2 : RANK_7) && is_ok(two) && pos.empty(two)) pawn(two);
+      }
+      for (int df : {-1, 1}) {
+        Square to = kd_step(from, df, dr);
+        if (is_ok(to) && !pos.empty(to) && color_of(pos.piece_on(to)) != us
+            && type_of(pos.piece_on(to)) != KING && kd_can_capture(PAWN, type_of(pos.piece_on(to)))) pawn(to);
+      }
+      continue;
+    }
+    for (Square to = SQ_A1; to < SQUARE_NB; ++to) {
+      if (to == from) continue;
+      Piece victim = pos.piece_on(to);
+      int df = int(file_of(to)) - int(file_of(from)), dr = int(rank_of(to)) - int(rank_of(from));
+      bool adjacent = std::max(std::abs(df), std::abs(dr)) == 1;
+      if (pt == KD_ARCHER || pt == KD_BEAST || pt == KD_GUARD) {
+        if (!victim && adjacent) add(make_move(from, to));
+        if (pt == KD_ARCHER && victim && color_of(victim) != us && type_of(victim) != KING
+            && pos.kingdown_attacks(from, to, pos.pieces())) add(make_kingdown(KD_SHOT, from, from, square_bb(to)));
+        continue;
+      }
+      if (pt == KD_CATAPULT) {
+        if (victim && color_of(victim) != us && type_of(victim) != KING
+            && pos.kingdown_attacks(from, to, pos.pieces())) add(make_kingdown(KD_SHOT, from, from, square_bb(to)));
+        if (!victim && (df == 0 || dr == 0)) {
+          int sf = (df > 0) - (df < 0), sr = (dr > 0) - (dr < 0);
+          Square at = kd_step(from, sf, sr);
+          while (at != to && pos.empty(at)) at = kd_step(at, sf, sr);
+          if (at == to) add(make_move(from, to));
+        }
+        continue;
+      }
+      if (pt == KD_MAESTER && victim && color_of(victim) == us
+          && (adjacent || (type_of(victim) == KING && rank_of(from) == (us == WHITE ? RANK_1 : RANK_8) && rank_of(to) == rank_of(from))))
+        add(make_kingdown(KD_SWAP, from, to, 0));
+      if (pt == KD_OGRE && victim && adjacent && type_of(victim) != KING) {
+        Square pushed = kd_step(to, df, dr);
+        if (is_ok(pushed) && pos.empty(pushed)) add(make_gating<KD_PUSH>(from, to, NO_PIECE_TYPE, pushed));
+      }
+      if (victim && (color_of(victim) == us || type_of(victim) == KING)) continue;
+      // Paladin quiet rays skip friends, unlike its target-sensitive attack predicate.
+      bool reachable = pos.kingdown_attacks(from, to, pos.pieces());
+      if (pt == KD_PALADIN && !victim) reachable = pos.kingdown_attacks(from, to, pos.pieces());
+      if (!reachable) continue;
+      if (pt == KD_PALADIN && victim && type_of(victim) != PAWN)
+        add(make_kingdown(KD_REMOVE, from, to, square_bb(to)));
+      else add(make_move(from, to));
+      if (pt == KD_REAVER && victim) for (auto delta : {std::pair<int,int>{1,0}, {-1,0}, {0,1}, {0,-1}}) {
+        Square land = kd_step(to, delta.first, delta.second);
+        if (is_ok(land) && pos.empty(land)) add(make_kingdown(KD_CHAIN, from, land, square_bb(to)));
+      }
+    }
+    if (pt == KD_BEAST) {
+      std::set<std::pair<uint64_t, int>> seen;
+      kd_chain(pos, moves, from, from, 0, seen);
+    }
+  }
+}
+} // namespace
+
+template<GenType T>
+void generate(const Position& pos, std::vector<ExtMove>& moves, size_t offset) {
+  if (!pos.kingdown_actions()) {
+    moves.resize(offset + MAX_MOVES);
+    auto* start = moves.data();
+    auto* end = generate<T>(pos, start + offset);
+    moves.resize(end - start);
+    return;
+  }
+  moves.resize(offset);
+  if (T == LEGAL && pos.is_immediate_game_end()) return;
+  kd_generate(pos, moves);
+  auto first = moves.begin() + offset;
+  moves.erase(std::remove_if(first, moves.end(), [&](const ExtMove& item) {
+    Move m = item;
+    return (T == CAPTURES && !pos.capture_or_promotion(m))
+        || ((T == QUIETS || T == QUIET_CHECKS) && pos.capture_or_promotion(m))
+        || (T == QUIET_CHECKS && !pos.gives_check(m))
+        || (T == LEGAL && !pos.legal(m));
+  }), moves.end());
+}
+template void generate<CAPTURES>(const Position&, std::vector<ExtMove>&, size_t);
+template void generate<QUIETS>(const Position&, std::vector<ExtMove>&, size_t);
+template void generate<QUIET_CHECKS>(const Position&, std::vector<ExtMove>&, size_t);
+template void generate<EVASIONS>(const Position&, std::vector<ExtMove>&, size_t);
+template void generate<NON_EVASIONS>(const Position&, std::vector<ExtMove>&, size_t);
+template void generate<LEGAL>(const Position&, std::vector<ExtMove>&, size_t);
+
 } // namespace Stockfish
