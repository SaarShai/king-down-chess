+ if(color(v)==side&&(jumpFriends||(always(c,side,KD_LEAP)&&type(v)==KD_P)))continue;
+ if(color(v)!=side&&type(v)!=KD_K&&can_capture(pc,type(v),c))out.push_back(action(from,to,bit(to),0,0,t==KD_L&&type(v)!=KD_P?KD_REMOVE_FLAG:0));break;}};
+ if(t==KD_P) {
+  int dr=side?-1:1;bool dark=c.kings[side]==KD_DARKNESS;
+  if(dark) {for(int df:{-1,1}){int to=step(from,df,dr);if(to>=0&&!p.board[to])pawn_move(out,from,to,side);}int to=step(from,0,dr);
+   if(to>=0&&p.board[to]&&color(p.board[to])!=side&&type(p.board[to])!=KD_K&&can_capture(pc,type(p.board[to]),c))pawn_move(out,from,to,side,bit(to));}
