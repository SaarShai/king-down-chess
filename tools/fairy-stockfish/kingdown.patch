+ if(power==KD_SACRIFICE||power==KD_SALVATION) {if(!p.lostPresent)return;for(int t=1;t<16;++t)if(returnable(t)&&p.lost[side*16+t]>0){if(power==KD_SACRIFICE){for(int s=0;s<64;++s)if(p.board[s]==piece(KD_P,side))out.push_back(action(s,s,0,power,t));}else for(int s=side?56:0;s<(side?64:8);++s)if(!p.board[s])out.push_back(action(s,s,0,power,0,t<<18));}return;}
