 /// Position::attackers_to() computes a bitboard of all pieces which attack a
 /// given square. Slider attacks use the occupied bitboard to indicate occupancy.
 
+bool Position::kingdown_attacks(Square from, Square target, Bitboard occupied) const {
+  if (from == target) return false;
+  Piece pc = piece_on(from);
+  PieceType pt = type_of(pc), victim = type_of(piece_on(target));
+  if (pt == KD_GUARD || (victim && !kd_can_capture(pt, victim))) return false;
+  int df = int(file_of(target)) - int(file_of(from)), dr = int(rank_of(target)) - int(rank_of(from));
+  int af = std::abs(df), ar = std::abs(dr);
+  bool diagonal = af == ar, orthogonal = !df || !dr;
+  if (pt == PAWN) return af == 1 && dr == (color_of(pc) == WHITE ? 1 : -1);
+  if (pt == KNIGHT || pt == KD_REAVER) return af * ar == 2;
+  if (pt == KD_ARCHER) return (af == 2 && !dr) || (!df && ar == 2) || (af == 2 && dr == (color_of(pc) == WHITE ? 2 : -2));
+  if (pt == KING || pt == KD_BEAST || pt == KD_MAESTER || pt == KD_OGRE || (pt == KD_TEMPLAR && !kd_capital(from)))
+    return std::max(af, ar) == 1;
+  if ((pt == BISHOP && !diagonal) || ((pt == ROOK || pt == KD_CATAPULT) && !orthogonal)
+      || ((pt == QUEEN || pt == KD_PALADIN || pt == KD_TEMPLAR) && !diagonal && !orthogonal)) return false;
+  int sf = (df > 0) - (df < 0), sr = (dr > 0) - (dr < 0), screens = 0;
+  for (Square at = kd_step(from, sf, sr); at != target; at = kd_step(at, sf, sr)) {
+    if (!is_ok(at)) return false;
+    if (!(occupied & at)) continue;
+    if (pt == KD_PALADIN && color_of(piece_on(at)) == color_of(pc)) continue;
+    if (pt != KD_CATAPULT || ++screens > 1 || color_of(piece_on(at)) == color_of(pc)) return false;
+  }
+  return pt != KD_CATAPULT || screens == 1;
+}
