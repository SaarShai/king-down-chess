node_modules/
dist/
.DS_Store

# Generated simulation data. Bulk files stay on disk and are recorded by tools/hash-baseline.mjs;
# simulation source (src/sim/**), specs (sim/specs/**) and the small reports/summaries/logs below
# are versioned (docs/TAKEOVER-PLAN.md §1). The old unanchored `sim/` pattern must never return: it
# excluded src/sim/** as well as every output.
/sim/out/**/*.jsonl
/sim/nnue/positions.bin
# Policy-distillation data: bulk binary, hash recorded in sim/nnue/policy.json (tracked).
/sim/nnue/policy.bin
/sim/tune/positions.bin

# Curated raw art sources (788 MB): preserved on disk with art-src/MANIFEST.md and the baseline
# hash manifest. Only the manifest is versioned; do not bulk-add gigabytes to Git.
/art-src/*
!/art-src/MANIFEST.md

# v0.7 build output is a build artifact; the preserved copy lives in docs/releases/v0.7.0/.
/dist/
# The takeover's review build (docs/RELEASE-REVIEW-2026-09-16.md); reproducible from its commit.
/dist-review/

# Original King Down art for the trailer; card illustration rights unconfirmed (docs/trailer/PLAN.md)
docs/trailer/assets/

# Local agent worktrees
/.claude/worktrees/
